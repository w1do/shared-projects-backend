#!/usr/bin/env bash
# cms — единая точка управления платформой.
#   ./tools/cms bootstrap                     развернуть всё с нуля: env, стек, миграции, демо-данные
#   ./tools/cms up|down|restart [service]     поднять/остановить стек или один сервис
#   ./tools/cms migrate [service]             миграции всех сервисов или одного
#   ./tools/cms test [service]                тесты всех сервисов или одного
#   ./tools/cms artisan <service> <args...>   artisan внутри контейнера сервиса
#   ./tools/cms api                           собрать единый swagger из всех сервисов
#   ./tools/cms e2e [--headed] [args...]      сценарии панели (Playwright) против поднятого стека
#   ./tools/cms seed-demo [project]           демо-контент в проект (по умолчанию demo)
#   ./tools/cms seed-load [проектов]          нагруженный стенд: 20 проектов с данными всех сервисов (0 — только очистка)
#   ./tools/cms deploy [версия]               выкатить: пересобрать и поднять сервисы вместе с воркерами
#   ./tools/cms version                       версия кода в каждом контейнере платформы
#   ./tools/cms image:build [тег]             собрать backend-образы четырёх сервисов для реестра
#   ./tools/cms image:push [тег]              отправить собранные образы в GitLab registry
#   ./tools/cms image:publish [тег]           собрать и отправить одной командой
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE="docker compose -f $ROOT/infra/compose/compose.yaml -f $ROOT/infra/compose/compose.dev.yaml"
SERVICES=(auth-service content-service analytics-service pay-service)

usage() { grep '^#   ' "$0" | sed 's/^#   //'; exit 1; }

# Значение ключа из корневого env. Читаем сами, а не через `. .env`: значения
# со спецсимволами не должны исполняться shell'ом.
env_value() {
    [ -f "$ROOT/infra/compose/.env" ] || return 0
    sed -n "s/^$1=//p" "$ROOT/infra/compose/.env" | head -n1 | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

# База реестра: CMS_REGISTRY_BASE (окружение или infra/compose/.env), иначе
# выводится из gitlab-remote как в Container Registry GitLab: registry.<хост>/<путь>.
registry_base() {
    local base remote path
    base="${CMS_REGISTRY_BASE:-$(env_value CMS_REGISTRY_BASE)}"
    if [ -n "$base" ]; then
        echo "$base"
        return
    fi
    remote=$(git -C "$ROOT" remote get-url gitlab 2>/dev/null || git -C "$ROOT" remote get-url origin 2>/dev/null || true)
    case "$remote" in
        *gitlab*)
            # git@host:path.git и https://host/path.git приводятся к host/path
            path=$(echo "$remote" | sed -e 's|^git@||' -e 's|^https\{0,1\}://||' -e 's|:|/|' -e 's|\.git$||')
            echo "registry.${path}"
            ;;
        *)
            echo "Реестр не определён: gitlab-remote не найден." >&2
            echo "Задайте CMS_REGISTRY_BASE=registry.gitlab.com/<группа>/<проект> (окружение или infra/compose/.env)" >&2
            echo "или добавьте remote: git remote add gitlab git@gitlab.com:<группа>/<проект>.git" >&2
            exit 1
            ;;
    esac
}

# Тег по умолчанию — короткий SHA коммита: по образу в реестре видно, что в нём
# собрано. `latest` ставится дополнительно, а не вместо.
image_tag() {
    if [ -n "${1:-}" ]; then
        echo "$1"
        return
    fi
    git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo latest
}

cmd="${1:-}"; shift || true
case "$cmd" in
    bootstrap)
        # Разворот с нуля одной командой: стек (env-дефолты в compose) → миграции
        # (AUTO_MIGRATE) → оператор/проект/манифесты → демо-контент.
        $COMPOSE up -d --build
        echo "==> жду готовности сервисов…"
        for s in auth content analytics pay; do
            until curl -sf "http://localhost:8080/health/$s" >/dev/null 2>&1; do sleep 3; done
            echo "    $s: ok"
        done
        "$ROOT/tools/smoke.sh"
        "$0" seed-demo
        echo ""
        echo "Готово: http://localhost:8080/login  (${ADMIN_EMAIL:-root@example.com} / ${ADMIN_PASSWORD:-secret-123})"
        echo "AI-переводы: положите OPENAI_API_KEY=... в infra/compose/.env"
        ;;
    up)       $COMPOSE up -d --build "${@}" ;;
    down)     $COMPOSE down "${@}" ;;
    restart)  $COMPOSE restart "${@}" ;;
    ps)       $COMPOSE ps ;;
    logs)     $COMPOSE logs -f "${@}" ;;
    migrate)
        targets=("${@:-${SERVICES[@]}}")
        [ $# -gt 0 ] && targets=("$@")
        for s in "${targets[@]}"; do
            echo "==> migrate $s"
            $COMPOSE exec -T -w "/var/www/apps/$s" "$s" php artisan migrate --force
        done
        ;;
    test)
        targets=("${SERVICES[@]}")
        [ $# -gt 0 ] && targets=("$@")
        for s in "${targets[@]}"; do
            echo "==> test $s"
            (cd "$ROOT/apps/$s" && php artisan test)
        done
        ;;
    artisan)
        s="$1"; shift
        $COMPOSE exec -T -w "/var/www/apps/$s" "$s" php artisan "$@"
        ;;
    api)
        exec "$ROOT/tools/build-openapi.sh"
        ;;
    deploy)
        # Воркеры и планировщики поднимаются той же командой, что и сервисы:
        # долгоживущий обработчик иначе остаётся на прежнем коде.
        version="${1:-$(image_tag)}"
        echo "==> выкат версии $version"
        APP_VERSION="$version" $COMPOSE up -d --build
        echo ""
        "$0" version
        ;;
    version)
        # Версия читается из окружения контейнера: расхождение сервиса и его
        # обработчика видно здесь, а не по логам приложения.
        for c in $($COMPOSE ps --services); do
            id=$($COMPOSE ps -q "$c" 2>/dev/null | head -n1)
            [ -n "$id" ] || continue
            env=$(docker inspect "$id" --format '{{range .Config.Env}}{{println .}}{{end}}' 2>/dev/null)
            # Контейнеры платформы отличает APP_SERVICE: базы и брокер версии не несут.
            echo "$env" | grep -q '^APP_SERVICE=' || continue
            v=$(echo "$env" | sed -n 's/^APP_VERSION=//p' | head -n1)
            printf '  %-22s %s\n' "$c" "${v:-unknown}"
        done
        ;;
    image:build)
        base=$(registry_base)
        tag=$(image_tag "${1:-}")
        for s in "${SERVICES[@]}"; do
            echo "==> build $base/$s:$tag"
            docker build -f "$ROOT/infra/docker/Dockerfile" --build-arg "APP_SERVICE=$s" \
                -t "$base/$s:$tag" -t "$base/$s:latest" "$ROOT"
        done
        echo ""
        echo "Образы собраны. Отправить: ./tools/cms image:push $tag"
        ;;
    image:push)
        base=$(registry_base)
        tag=$(image_tag "${1:-}")
        for s in "${SERVICES[@]}"; do
            if ! docker image inspect "$base/$s:$tag" >/dev/null 2>&1; then
                echo "Образа $base/$s:$tag нет локально — сначала ./tools/cms image:build $tag" >&2
                exit 1
            fi
        done
        # Логин не автоматизируется: пароль в аргументе виден в списке процессов.
        # docker login хранит токен сам.
        for s in "${SERVICES[@]}"; do
            echo "==> push $base/$s:$tag"
            if ! docker push "$base/$s:$tag"; then
                echo "push не прошёл. Если дело в доступе: docker login ${base%%/*}" >&2
                exit 1
            fi
            docker push "$base/$s:latest"
        done
        echo ""
        echo "Образы в реестре ($base/*:$tag)."
        ;;
    image:publish)
        "$0" image:build "${1:-}"
        "$0" image:push "${1:-}"
        ;;
    seed-demo)
        # Идентификатор берётся из auth-service: сидер не должен угадывать проект —
        # в базе контента остаются записи прежних проектов после пересоздания.
        key="${1:-demo}"
        pid=$($COMPOSE exec -T -w /var/www/apps/auth-service auth-service php artisan tinker --execute="
\$p = Cms\Auth\Domain\Models\Project::query()->where('key', '${key}')->first();
echo \$p ? \$p->id : '';" 2>/dev/null | tr -d '\r\n ')
        if [ -z "$pid" ]; then
            echo "Проект '${key}' не найден в auth-service." >&2
            exit 1
        fi
        echo "==> seed-demo: проект ${key} (${pid})"
        $COMPOSE exec -T -e "DEMO_PROJECT_ID=$pid" -w /var/www/apps/content-service content-service \
            php artisan db:seed --class="Database\Seeders\DemoContentSeeder" --force
        ;;
    seed-load)
        # Нагруженный стенд. auth-сеялка — источник истины по составу проектов:
        # она печатает LOAD_PROJECT_IDS (свои прежние и новые проекты), остальные
        # сеялки удаляют данные всех перечисленных и засеивают первые LOAD_PROJECTS.
        count="${1:-20}"
        app_env=$($COMPOSE exec -T -w /var/www/apps/auth-service auth-service \
            php artisan tinker --execute="echo app()->environment();" 2>/dev/null | tr -d '\r\n ')
        if [ "$app_env" = "production" ]; then
            echo "seed-load не запускается в production: окружение auth-service — production." >&2
            exit 1
        fi

        work=$(mktemp -d)
        trap 'rm -rf "$work"' EXIT
        summary="$work/summary"
        : >"$summary"
        started=$(date +%s)

        run_load_seeder() {
            local service="$1"; shift
            local step
            step=$(date +%s)
            echo "==> seed-load: $service"
            $COMPOSE exec -T "$@" -w "/var/www/apps/$service" "$service" \
                php artisan db:seed --class="Database\Seeders\LoadSeeder" --force \
                | tee "$work/$service.out" | sed '/^LOAD_/d'
            printf '%s\t%ss\t%s\n' "$service" "$(( $(date +%s) - step ))" \
                "$(sed -n 's/^LOAD_STATS=[^:]*: //p' "$work/$service.out" | tail -n1)" >>"$summary"
        }

        run_load_seeder auth-service -e "LOAD_PROJECTS=$count"
        ids=$(sed -n 's/^LOAD_PROJECT_IDS=//p' "$work/auth-service.out" | tail -n1 | tr -d '\r')

        for s in content-service pay-service analytics-service; do
            run_load_seeder "$s" -e "LOAD_PROJECT_IDS=$ids" -e "LOAD_PROJECTS=$count"
        done

        echo ""
        echo "==> сводка seed-load (проектов: $count)"
        awk -F'\t' '{ printf "  %-18s %6s  %s\n", $1, $2, $3 }' "$summary"
        echo "  всего: $(( $(date +%s) - started ))s"

        skipped=$(cat "$work"/*.out | sed -n 's/^LOAD_SKIP=/    - /p')
        if [ -n "$skipped" ]; then
            echo "  пропущено:"
            echo "$skipped"
        fi
        ;;
    e2e)
        # Сценарии идут против стека, поднятого `up`: панель внутри контейнера
        # собрана в production-режиме, поэтому после правок в frontends/admin
        # её нужно перезапустить — иначе проверяется прежняя сборка.
        echo "==> e2e: панель проверяется как есть в контейнере."
        echo "    После правок в frontends/admin: docker restart platform-admin-front-1"
        if [ "${1:-}" = "--headed" ]; then
            shift
            export E2E_HEADED=1
            : "${DISPLAY:=:0}"; export DISPLAY
        fi
        # Библиотеки браузера, распакованные без root (см. docs/admin-console.md).
        deps="$HOME/.local/lib/playwright-deps"
        [ -d "$deps" ] && export LD_LIBRARY_PATH="$deps${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
        (cd "$ROOT/e2e" && npx playwright test "$@")
        ;;
    *) usage ;;
esac
