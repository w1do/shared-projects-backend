includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - ../../packages/cms/shared/src
        - ../../packages/cms/contracts/src
        - ../../packages/cms/pay/src
        - ../../packages/cms/licensing/src
        - ../../packages/cms/shared/routes
        - ../../packages/cms/pay/routes
        - ../../packages/cms/licensing/routes
    databaseMigrationsPath:
        - ../../packages/cms/pay/database/migrations
        - ../../packages/cms/licensing/database/migrations
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
