<?php

declare(strict_types=1);

namespace Cms\{{Studly}}\Presentation\Http\Api\V1\Resources\Item;

use Cms\{{Studly}}\Application\DTOs\Item\ItemDTO;
use Cms\Shared\Http\Resources\ApiResource;
use Illuminate\Http\Request;

/**
 * ВСЕ ответы модуля — через Resource; конверт `{"data": ...}` даёт ApiResource.
 *
 * @property ItemDTO $resource
 */
final class ItemResource extends ApiResource
{
    /** @return array<string, mixed> */
    public function toArray(Request $request): array
    {
        return $this->resource->toArray();
    }
}
