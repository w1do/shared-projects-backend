<?php

use Cms\{{Studly}}\Presentation\Http\Api\V1\Controllers\Admin\ItemController;
use Cms\Shared\AuthClient\Middleware\AuthorizeOperator;
use Cms\Shared\AuthClient\Middleware\EnsureServiceEnabled;
use Illuminate\Support\Facades\Route;

// Каждый admin-маршрут закрыт правом <service>.<resource>.<action>.
$authorize = fn (string $permission) => [AuthorizeOperator::class.':'.$permission, EnsureServiceEnabled::class.':{{name}}'];

Route::prefix('api/admin/v1/projects/{project}/{{name}}')->group(function () use ($authorize) {
    Route::get('items', [ItemController::class, 'index'])->middleware($authorize('{{name}}.items.view'));
    Route::post('items', [ItemController::class, 'store'])->middleware($authorize('{{name}}.items.manage'));
    Route::put('items/{item}', [ItemController::class, 'update'])->middleware($authorize('{{name}}.items.manage'));
});
