<?php

use Cms\{{Studly}}\Presentation\Http\Api\V1\Controllers\Site\ItemController;
use Cms\Shared\AuthClient\Middleware\AuthorizeProjectKey;
use Cms\Shared\AuthClient\Middleware\EnsureServiceEnabled;
use Illuminate\Support\Facades\Route;

Route::prefix('api/v1/{{name}}')
    ->middleware([AuthorizeProjectKey::class, EnsureServiceEnabled::class.':{{name}}'])
    ->group(function () {
        Route::get('items', [ItemController::class, 'index']);
    });
