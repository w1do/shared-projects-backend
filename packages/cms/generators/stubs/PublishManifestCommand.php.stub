<?php

declare(strict_types=1);

namespace Cms\{{Studly}}\Console;

use Cms\{{Studly}}\{{Studly}}Manifest;
use Cms\Shared\AuthClient\AuthClient;
use Illuminate\Console\Command;

final class PublishManifestCommand extends Command
{
    protected $signature = 'manifest:publish';

    protected $description = 'Publish the {{name}} service manifest to auth-service';

    public function handle(AuthClient $client): int
    {
        if (! $client->publishManifest({{Studly}}Manifest::build())) {
            $this->error('auth-service rejected the manifest.');

            return self::FAILURE;
        }

        $this->info('{{Studly}} manifest published.');

        return self::SUCCESS;
    }
}
