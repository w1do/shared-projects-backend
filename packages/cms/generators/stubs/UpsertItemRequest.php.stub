<?php

declare(strict_types=1);

namespace Cms\{{Studly}}\Presentation\Http\Api\V1\Requests\Item;

use Cms\{{Studly}}\Application\DTOs\Item\UpsertItemDTO;
use Cms\{{Studly}}\Domain\Enums\ItemStatus;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

/**
 * ВСЯ HTTP-валидация модуля живёт в FormRequest'ах — ни в DTO, ни в контроллере,
 * ни в handler'е. Порядок правил задаёт порядок ключей в `error.details`.
 */
final class UpsertItemRequest extends FormRequest
{
    /** @return array<string, list<mixed>> */
    public function rules(): array
    {
        return [
            'title' => ['required', 'string', 'max:255'],
            'status' => ['sometimes', 'string', Rule::enum(ItemStatus::class)],
        ];
    }

    /** DTO собирается из validated() целиком (И1): ключей руками не достраиваем. */
    public function upsert(): UpsertItemDTO
    {
        return UpsertItemDTO::from($this->validated());
    }
}
