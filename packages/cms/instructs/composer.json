{
    "name": "cms/instructs",
    "description": "CMS platform package: reusable generation instructions with a declared response schema",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "cms/shared": "*",
        "cms/ai": "*",
        "spatie/laravel-data": "^4.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Instructs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Instructs\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.0",
    "extra": {
        "laravel": {
            "providers": [
                "Cms\\Instructs\\Infrastructure\\Providers\\InstructsServiceProvider"
            ]
        }
    }
}
