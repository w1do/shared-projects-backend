{
    "name": "cms/research",
    "description": "CMS platform package: topic research, project knowledge base and post topics",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "cms/shared": "*",
        "cms/ai": "*",
        "cms/content": "*",
        "cms/instructs": "*",
        "spatie/laravel-data": "^4.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Research\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Research\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.0",
    "extra": {
        "laravel": {
            "providers": [
                "Cms\\Research\\Infrastructure\\Providers\\ResearchServiceProvider"
            ]
        }
    }
}
