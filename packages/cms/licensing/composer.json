{
    "name": "cms/licensing",
    "description": "CMS platform package: licensing",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "cms/shared": "*",
        "cms/contracts": "*",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-query-builder": "^6.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Licensing\\": "src/",
            "Cms\\Licensing\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Licensing\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.0",
    "extra": {
        "laravel": {
            "providers": [
                "Cms\\Licensing\\Infrastructure\\Providers\\LicensingServiceProvider"
            ]
        }
    }
}
