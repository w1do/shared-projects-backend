{
    "name": "cms/auth",
    "description": "CMS platform package: auth",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "cms/shared": "*",
        "laravel/sanctum": "^4.0|^5.0",
        "spatie/laravel-permission": "^8.0",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "spatie/laravel-data": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Cms\\Auth\\": "src/",
            "Cms\\Auth\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cms\\Auth\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "version": "0.1.0",
    "extra": {
        "laravel": {
            "providers": [
                "Cms\\Auth\\AuthServiceProvider"
            ]
        }
    }
}