# Корневой env производственного деплоя: скопируйте в infra/compose/.env
# (или задайте переменные окружения проекта в Dokploy). Без него стек стартует
# в dev-режиме на небезопасных dev-дефолтах — в проде переопределить ВСЁ из этого файла.

# --- Приложение ---
APP_ENV=production
APP_DEBUG=false
# Публичный URL площадки (домен, повешенный на сервис gateway в Dokploy)
APP_URL=https://platform.example.com

# --- Пароли хранилищ ---
# Генерация: openssl rand -hex 24
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=

# --- Межсервисный токен ---
# Генерация: openssl rand -hex 32
SERVICE_TOKEN=

# --- Ключи приложений (по одному на сервис) ---
# Генерация каждого: echo "base64:$(openssl rand -base64 32)"
AUTH_APP_KEY=
CONTENT_APP_KEY=
ANALYTICS_APP_KEY=
PAY_APP_KEY=

# --- Корневой оператор панели (создаётся при первом старте, ADMIN_SEED) ---
ADMIN_EMAIL=
# Генерация: openssl rand -base64 18
ADMIN_PASSWORD=

# --- Стартовый проект (создаётся при первом старте, если проектов ещё нет) ---
#INITIAL_PROJECT_KEY=main
#INITIAL_PROJECT_NAME=Main
# Локали проекта через запятую, первая — основная
#INITIAL_PROJECT_LOCALES=ru,en

# --- Аналитика ---
# Соль хэширования IP посетителей. Генерация: openssl rand -hex 16
ANALYTICS_IP_SALT=

# --- Опциональные интеграции ---
# AI-переводы (cms/ai): ключ OpenAI-совместимого провайдера (по умолчанию Polza)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://polza.ai/api/v1
#CMS_AI_MODEL=openai/gpt-5.4-mini
# Публичный URL медиа (S3/MinIO), если медиа отдаются с отдельного домена
#AWS_URL=
# Платёжный шлюз Platega (переопределение только для стендов/моков)
#PLATEGA_BASE_URL=

# --- Локальный запуск ---
# Порт публикации gateway на хосте (в Dokploy не нужен — домен ведёт на контейнерный :80)
#GATEWAY_PORT=8080

# --- Публикация образов (./tools/cms image:publish) ---
# База Container Registry GitLab; образы уходят как <база>/<service>:<тег>
#CMS_REGISTRY_BASE=registry.gitlab.com/<группа>/<проект>
