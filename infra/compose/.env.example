# Корневой env производственного деплоя: скопируйте в infra/compose/.env
# (или задайте переменные окружения проекта в Dokploy). Без него стек стартует
# в dev-режиме на небезопасных dev-дефолтах — в проде переопределить ВСЁ из этого файла.

# --- Приложение ---
APP_ENV=production
APP_DEBUG=false
# Публичный URL площадки (домен, повешенный на сервис gateway в Dokploy)
APP_URL=https://platform.example.com

# --- Пароли хранилищ ---
# ВАЖНО: фиксируются при первом старте (создание томов). Смена пароля позже
# не меняет его в самой БД — сервисы перестанут подключаться; менять только
# внутри БД либо вместе с пересозданием тома.
# Генерация: openssl rand -hex 24
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=

# --- Межсервисный токен ---
# Генерация: openssl rand -hex 32
SERVICE_TOKEN=

# --- Ключи приложений (по одному на сервис) ---
# Генерация каждого: echo "base64:$(openssl rand -base64 32)"
AUTH_APP_KEY=
CONTENT_APP_KEY=
ANALYTICS_APP_KEY=
PAY_APP_KEY=

# --- Корневой оператор панели (создаётся при первом старте, ADMIN_SEED) ---
# При APP_ENV=production dev-пароль по умолчанию не принимается: без своего
# значения оператор не создаётся вовсе (публичные креды из репозитория).
ADMIN_EMAIL=
# Генерация: openssl rand -base64 18
ADMIN_PASSWORD=

# --- Стартовый проект (создаётся при первом старте, если проектов ещё нет) ---
#INITIAL_PROJECT_KEY=main
#INITIAL_PROJECT_NAME=Main
# Локали проекта через запятую, первая — основная
#INITIAL_PROJECT_LOCALES=ru,en

# --- Аналитика ---
# Соль хэширования IP посетителей. Генерация: openssl rand -hex 16
ANALYTICS_IP_SALT=

# --- Почта (сброс пароля, приглашения) ---
# Без SMTP письма уходят в лог контейнера (MAIL_MAILER=log), а сброс пароля
# оператора не доходит до адресата.
#MAIL_MAILER=smtp
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_SCHEME=tls
#MAIL_FROM_ADDRESS=no-reply@example.com
#MAIL_FROM_NAME=Platform

# --- Опциональные интеграции ---
# AI-переводы (cms/ai): ключ OpenAI-совместимого провайдера (по умолчанию Polza)
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://polza.ai/api/v1
#CMS_AI_MODEL=openai/gpt-5.4-mini
# Модель эмбеддингов базы знаний и её размерность. Размерность должна
# соответствовать модели: коллекция Qdrant создаётся под неё один раз.
#CMS_AI_EMBEDDING_MODEL=openai/text-embedding-3-small
#CMS_AI_EMBEDDING_DIMENSION=1536

# --- База знаний (Qdrant) ---
# Контейнер поднимается вместе со стеком и наружу не публикуется — это и есть
# граница доступа. QDRANT_API_KEY нужен, только если Qdrant вынесен на отдельный
# хост: ключ уходит в заголовке запроса, а на стороне самого Qdrant включается
# отдельно (QDRANT__SERVICE__API_KEY в его окружении). Пустое значение этой
# переменной у контейнера Qdrant включает проверку с непригодным ключом —
# поэтому в базовом compose она не задаётся вовсе.
#QDRANT_URL=http://qdrant:6333
#QDRANT_API_KEY=
#QDRANT_COLLECTION=knowledge

# --- Ресёрч (поисковая служба SerpApi) ---
# Без ключа запуск исследования отклоняется понятной ошибкой конфигурации
#SERPAPI_KEY=
#SERPAPI_BASE_URL=https://serpapi.com
#RESEARCH_ENGINE=yandex
#RESEARCH_SUBQUERIES_COUNT=4
#RESEARCH_RESULTS_PER_SUBQUERY=5
# Предел одновременно выполняющихся исследований на проект
#RESEARCH_MAX_CONCURRENT=3
# Публичный URL медиа. По умолчанию — <APP_URL>/media через gateway;
# задавайте, только если медиа отдаются с отдельного домена или CDN
#AWS_URL=
# Базовый URL сайта в sitemap.xml/robots.txt (по умолчанию — APP_URL)
#CONTENT_SITE_URL=
# Платёжный шлюз Platega (переопределение только для стендов/моков)
#PLATEGA_BASE_URL=

# --- Публикация gateway на хосте ---
# Порт (в Dokploy не нужен — домен ведёт на контейнерный :80; меняйте, если 8080 занят)
#GATEWAY_PORT=8080
# Интерфейс публикации. В проде ставьте 127.0.0.1: иначе стек доступен по plain
# HTTP на публичном IP мимо TLS внешнего прокси
#GATEWAY_BIND=127.0.0.1

# --- Публикация образов (./tools/cms image:publish) ---
# База Container Registry GitLab; образы уходят как <база>/<service>:<тег>
#CMS_REGISTRY_BASE=registry.gitlab.com/<группа>/<проект>
