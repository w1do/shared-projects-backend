APP_NAME=content-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=content_service
DB_USERNAME=platform
DB_PASSWORD=platform

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# service-to-service
AUTH_SERVICE_URL=http://auth-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000
SERVICE_TOKEN=dev-service-token
INTROSPECTION_CACHE_TTL=90

# Медиа — S3 (MinIO)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=platform
AWS_SECRET_ACCESS_KEY=platform-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=media
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/media
