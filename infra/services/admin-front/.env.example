# Панель управления (frontends/admin) — переменные вёрстки.
# Режим данных: api — реальные данные платформы, mock — демо-данные вёрстки.
NEXT_PUBLIC_ADMIN_DATA_SOURCE=api

# Базовый URL API платформы. Панель и API отдаются одним gateway,
# поэтому в браузере запросы уходят на origin панели (пустое значение = same-origin).
NEXT_PUBLIC_ADMIN_API_BASE_URL=

# Задержка mock-данных (мс). 0 / пусто — без задержки.
NEXT_PUBLIC_ADMIN_MOCK_DELAY_MS=0

# Базовый URL для серверных запросов внутри docker-сети (SSR/route handlers).
ADMIN_INTERNAL_API_BASE_URL=http://gateway:80
