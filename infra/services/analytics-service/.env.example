APP_NAME=analytics-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=analytics_service
DB_USERNAME=platform
DB_PASSWORD=platform

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

# service-to-service
AUTH_SERVICE_URL=http://auth-service:8000
ANALYTICS_SERVICE_URL=http://analytics-service:8000
SERVICE_TOKEN=dev-service-token
INTROSPECTION_CACHE_TTL=90

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USERNAME=platform
CLICKHOUSE_PASSWORD=platform
