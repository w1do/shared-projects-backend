:80 {
	encode gzip

	# Модульные admin-маршруты внутри проекта — раньше catch-all auth'а
	@contentAdmin path_regexp ^/api/admin/v1/projects/[^/]+/content(/|$)
	handle @contentAdmin {
		reverse_proxy content-service:8000
	}

	@analyticsAdmin path_regexp ^/api/admin/v1/projects/[^/]+/analytics(/|$)
	handle @analyticsAdmin {
		reverse_proxy analytics-service:8000
	}

	@payAdmin path_regexp ^/api/admin/v1/projects/[^/]+/pay(/|$)
	handle @payAdmin {
		reverse_proxy pay-service:8000
	}

	# auth-service: аутентификация, tenant, bootstrap
	@auth path /api/admin/v1/* /api/v1/auth/*
	handle @auth {
		reverse_proxy auth-service:8000
	}

	# публичные маршруты сервисов
	@content path /api/v1/content/* /sitemap.xml /robots.txt
	handle @content {
		reverse_proxy content-service:8000
	}

	@analytics path /api/v1/collect /api/v1/analytics/*
	handle @analytics {
		reverse_proxy analytics-service:8000
	}

	@pay path /api/v1/pay/* /webhooks/*
	handle @pay {
		reverse_proxy pay-service:8000
	}

	# health каждого сервиса
	handle /health/auth {
		rewrite * /health
		reverse_proxy auth-service:8000
	}
	handle /health/content {
		rewrite * /health
		reverse_proxy content-service:8000
	}
	handle /health/analytics {
		rewrite * /health
		reverse_proxy analytics-service:8000
	}
	handle /health/pay {
		rewrite * /health
		reverse_proxy pay-service:8000
	}

	# всё остальное — панель управления (Next.js на Bun):
	# статика /_next/*, /login, /admin* и корень (Next редиректит / → /admin)
	handle {
		reverse_proxy admin-front:3000
	}
}
