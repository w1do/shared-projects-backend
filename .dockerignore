# Контекст сборки — корень репозитория; в образ попадают только
# packages/cms, apps/<APP_SERVICE> и infra/docker (см. infra/docker/Dockerfile).
# Всё остальное — лишний вес контекста.

.git
.github
.idea
.ai
.claude
.vscode

# фронты, тесты, документация — в php-образ не нужны
frontends
e2e
docs
openspec
openapi
packages/frontend
node_modules
package.json
package-lock.json

# зависимости и артефакты — ставятся внутри образа
**/vendor
**/node_modules
**/.phpunit.cache
**/.phpunit.result.cache
**/storage/logs/*
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*

# секреты и локальные env — в образ только через compose env_file
**/.env
**/.env.local
**/.env.backup
infra/services

*.log
.DS_Store
